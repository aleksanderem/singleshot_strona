DATABASE_URI=postgres://user:password@host:5432/dbname
PAYLOAD_SECRET=generate-a-long-random-string
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4321

# Auto-rebuild webhook — fired (debounced 2s) after any content change.
# Plug in a Vercel Deploy Hook, Netlify Build Hook, Cloudflare Pages Deploy Hook,
# or a GitHub Actions repository_dispatch endpoint here.
# Leave unset in dev — Astro re-fetches on every request, no rebuild needed.
# REBUILD_WEBHOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxx/yyy
# REBUILD_WEBHOOK_METHOD=POST
# REBUILD_WEBHOOK_AUTH=Bearer <token>
# REBUILD_WEBHOOK_BODY={"event_type":"rebuild"}

# SMTP — required in prod for password reset and admin invite emails.
# Skip in dev: outgoing mail is logged to console.
# SMTP_HOST=smtp.eu.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@mg.singleshot.pl
# SMTP_PASS=...
# SMTP_FROM_ADDRESS=no-reply@singleshot.pl
# SMTP_FROM_NAME=SingleShot

# S3 / S3-compatible storage for media (Cloudflare R2, Backblaze B2, MinIO, AWS S3).
# Skip in dev: media is stored under cms/media/ on the local filesystem.
# S3_BUCKET=singleshot-media
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_FORCE_PATH_STYLE=false
